# Tâches cron de root — état attendu sur LES DEUX nœuds.
#
# Capturé le 15/08/2026 à l'identique de la production. Les chemins sont absolus :
# déplacer l'un de ces scripts sans mettre ce fichier ET les deux crontabs à jour
# coupe la bascule, le failover et les alertes, sans que rien ne le signale.
#
# Pose : sudo crontab -e sur chaque nœud (geste explicite, jamais automatique).
0 2 * * * /opt/5hostachy/bascule.sh >> /var/log/hostachy-bascule.log 2>&1
0 3 * * 0 /opt/5hostachy/maintenance.sh >> /var/log/hostachy-maintenance.log 2>&1
2,7,12,17,22,27,32,37,42,47,52,57 * * * * /opt/5hostachy/health-watch.sh >> /var/log/hostachy-health-watch.log 2>&1
6,21,36,51 * * * * /opt/5hostachy/check-reliability.sh >> /var/log/hostachy-reliability.log 2>&1
