#!/bin/sh
# Refuse un commit si la branche locale est en retard sur son upstream.
#
# Pourquoi : `origin/dev` et `origin/main` n'avancent quasiment jamais en local.
# Le flux est local dev -> push -> PR vers main -> *merge côté GitHub* -> puis
# « Merge branch 'main' into dev », lui aussi côté GitHub. Ces commits de merge
# ne redescendent que si quelqu'un fait explicitement un `git fetch`. Rien dans
# le processus ne le faisait : le clone local dérivait donc d'exactement le
# nombre de PR fusionnées depuis le dernier pull manuel (16 le 26/07/2026, et
# `main` à 151 commits de retard).
#
# Committer sur une base périmée expose à : conflits de version dans
# `front/package.json`, réintroduction de code déjà corrigé en amont, et surtout
# divergence de migrations Alembic entre le code et la base (la classe de panne
# que le point 10 du pré-check MEP existe pour attraper).
#
# Contournement ponctuel (hors-ligne, urgence) : ALLOW_STALE=1 git commit ...

# ── Fins de ligne : un diff gonflé par des terminaisons n'est plus relisible ──
#  Quatrième récidive le 20/08/2026 : trois fichiers convertis de CRLF vers LF
#  pendant des lots qui ne changeaient que quelques lignes. La PR annonçait
#  2 998 ajouts / 2 743 suppressions pour un changement réel d'une dizaine de
#  lignes — et c'est l'utilisateur qui l'a vu, juste avant de fusionner.
#  `standards/10` réclamait ce contrôle ; le voici. Dérogation : ALLOW_EOL=1
if command -v python >/dev/null 2>&1; then
    python "$(git rev-parse --show-toplevel)/scripts/poste/verifier-fins-de-ligne.py" || exit 1
elif command -v python3 >/dev/null 2>&1; then
    python3 "$(git rev-parse --show-toplevel)/scripts/poste/verifier-fins-de-ligne.py" || exit 1
fi

[ -n "$ALLOW_STALE" ] && exit 0

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)
[ -z "$upstream" ] && exit 0   # branche sans upstream (locale) : rien à vérifier

# Fetch borné dans le temps : hors-ligne, on laisse passer plutôt que bloquer.
if command -v timeout >/dev/null 2>&1; then
    timeout 15 git fetch --quiet "$(echo "$upstream" | cut -d/ -f1)" 2>/dev/null
else
    git fetch --quiet "$(echo "$upstream" | cut -d/ -f1)" 2>/dev/null
fi

behind=$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
[ "$behind" -eq 0 ] 2>/dev/null && exit 0

# Être « en retard » de N commits n'est pas la même chose qu'avoir un contenu
# différent. Les PR étant fusionnées en SQUASH, `main` ne partage aucun commit
# avec `dev` : après chaque fusion, on RÉALIGNE `dev` sur `main`, ce qui laisse le
# clone en retard sur `origin/dev` avec un arbre RIGOUREUSEMENT identique.
# Refuser ce cas ferait passer ALLOW_STALE=1 dans l'habitude — et un garde-fou
# qu'on contourne par réflexe ne garde plus rien (socle 04 §18). On compare donc
# les ARBRES, comme le point 0a de precheck-mep.sh, avec lequel ce hook doit
# rester cohérent : un contenu absent, lui, est toujours refusé.
# ⚠️ Ne PAS comparer notre arbre à $upstream : dès le premier commit suivant, ils
# diffèrent légitimement et tout serait refusé. La question est asymétrique —
# $upstream apporte-t-il quelque chose que nous n'avons pas ? Deux conditions :
# son contenu est déjà celui de origin/main, et notre HEAD descend de origin/main.
# Même règle que le point 0a de precheck-mep.sh : les deux doivent rester alignés,
# sinon l'un autorise ce que l'autre refuse.
if git diff --quiet "$upstream" origin/main 2>/dev/null    && git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then exit 0; fi

branche=$(git rev-parse --abbrev-ref HEAD)
cat >&2 <<MSG

✗ Commit refusé : '$branche' est en retard de $behind commit(s) sur $upstream.

  Committer ici créerait une base divergente (versions, migrations Alembic).
  Resynchronise d'abord :

      git stash push -u          # si tu as du travail en cours
      git merge --ff-only $upstream
      git stash pop

  Puis relance ton commit. En dernier recours : ALLOW_STALE=1 git commit ...

MSG
exit 1
