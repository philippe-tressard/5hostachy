{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/env-report.sh; cat .claude/5hostachy-preflight.md",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Environnement + consignes 5Hostachy…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/cloud/garde-git.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
