{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-X", "utf8", "-m", "uvicorn", "app.main:app", "--port", "8000"],
      "cwd": "api",
      "port": 8000
    },
    {
      "name": "front-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173"],
      "cwd": "front",
      "port": 5173
    },
    {
      "name": "front-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "cwd": "front",
      "port": 4173
    }
  ]
}
